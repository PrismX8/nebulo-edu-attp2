# Server Configuration
PORT=5000
NODE_ENV=development
MCP_PORT=1337
APP_DEBUG=true
APP_ORIGIN=http://localhost:5000
JSON_BODY_LIMIT=3mb
URLENCODED_BODY_LIMIT=256kb
TLK_MESSAGE_CACHE_TTL_MS=900
TLK_MESSAGE_LIMIT=100
CHAT_MAX_MESSAGE_LENGTH=1500
PRESENCE_CACHE_TTL_MS=2500
DISABLE_VOICE=false
DISABLE_MESSAGE_COIN_REWARD=false
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=10000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/k-chat

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=kchat_inventory

# Nebulo account/profile PostgreSQL database
# Use a database role limited to SELECT on users/profiles and UPDATE of
# profiles.avatar_url + profiles.updated_at in production.
PROFILE_DB_HOST=database.example.com
PROFILE_DB_PORT=5432
PROFILE_DB_USER=nebulo_profile_app
PROFILE_DB_PASSWORD=replace_me
PROFILE_DB_NAME=app
PROFILE_DB_SSL=false

# JWT Token - use a long random value in real deployments
JWT_SECRET=replace_with_at_least_32_random_characters

# File Storage
UPLOAD_PATH=./uploads
# Chat image uploads must go to Quizizz static/S3.
QUIZIZZ_SIGN_URL_ENDPOINT=https://media.quizizz.com/_mdserver/main/getUploadURL
QUIZIZZ_UPLOAD_DESTINATION=uploadedFiles
QUIZIZZ_UPLOAD_FOLDER=_quizizzAIGenDocs
# ContentMod image analyzer settings.
IMAGE_MODERATION_ENABLED=true
IMAGE_MODERATION_BLOCK_RATINGS=reject,nsfw,r,x,adult_content,explicit_nudity

# Database Configuration
DATABASE_URL=sqlite:///app.db

# OpenBullet2 Integration
OPENBULLET_API_URL=http://localhost:5000
OPENBULLET_API_KEY=your_api_key
OPENBULLET_WEBHOOK_SECRET=your_webhook_secret

# Notification Configuration
NOTIFICATION_EMAIL=admin@example.com
NOTIFICATION_SMS=+1234567890
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# GitHub Configuration
GITHUB_TOKEN=your_github_token
