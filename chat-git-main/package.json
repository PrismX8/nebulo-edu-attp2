{
  "name": "k-chat",
  "version": "0.1.0",
  "description": "An open-source self-hosted messaging platform with AI integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "echo \"Client is served statically by the backend at /client/public\"",
    "dev:full": "npm run dev",
    "up": "npm run dev:full",
    "install:all": "npm install && cd client && npm install",
    "build": "echo \"No frontend build step required for vanilla client\"",
    "test": "jest",
    "init-db": "node scripts/init-postgres.js"
  },
  "keywords": [
    "chat",
    "messaging",
    "telegram",
    "self-hosted",
    "open-source",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/cosmos": "^4.0.0",
    "@azure/openai": "^1.0.0-beta.11",
    "@azure/search-documents": "^12.0.0",
    "@azure/storage-blob": "^12.17.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.1",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "telegraf": "^4.15.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
